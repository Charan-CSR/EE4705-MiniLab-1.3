<?xml version="1.0" encoding="utf-8"?>
<!-- Contributor: Charansagar Ramanujam (Task 2 scene) -->

<mujoco model="YOLO Robot Vision Lab">

  <asset>

   <texture name="mug_texture"
         file="yolo_lab_assets/mug.png"
         type="2d"/>

   <material name="mug_material"
          texture="mug_texture"
          specular="1"
          shininess="1"/>
  
   <material name="red_mug_material"
          rgba="0.85 0.05 0.05 1"
          specular="0.4"
          shininess="0.5"/>


   <mesh name="mug_mesh"
      file="yolo_lab_assets/mug.obj"
      scale="0.02 0.02 0.02"/>
   
   <mesh name="bowl_mesh"
      file="yolo_lab_assets/bowl.stl"/>


    <texture
        type="2d"
        name="lab_floor_texture"
        builtin="checker"
        rgb1="0.22 0.25 0.28"
        rgb2="0.15 0.18 0.21"
        width="512"
        height="512"/>

    <material
        name="lab_floor"
        texture="lab_floor_texture"
        texuniform="true"
        texrepeat="8 8"
        reflectance="0.08"/>
  </asset>
  <worldbody>

    <!-- Main 8 m x 8 m laboratory floor -->
    <geom
        name="floor"
        type="plane"
        pos="0 0 0"
        size="4 4 0.05"
        material="lab_floor"/>

    <!-- Back wall -->
    <geom
        name="back_wall"
        type="box"
        pos="4 0 0.6"
        size="0.05 4 0.6"
        rgba="0.72 0.76 0.80 1"/>

    <!-- Left wall -->
    <geom
        name="left_wall"
        type="box"
        pos="0 4 0.6"
        size="4 0.05 0.6"
        rgba="0.72 0.76 0.80 1"/>

    <!-- Right wall -->
    <geom
        name="right_wall"
        type="box"
        pos="0 -4 0.6"
        size="4 0.05 0.6"
        rgba="0.72 0.76 0.80 1"/>
    
    <!-- Front wall -->
    <geom
       name="front_wall"
       type="box"
       pos="-4 0 0.6"
       size="0.05 4 0.6"
       rgba="0.72 0.76 0.80 1"/>


    <!-- Start zone -->
    <geom
        name="start_zone"
        type="box"
        pos="0 0 0.003"
        size="0.65 0.65 0.003"
        rgba="0.15 0.55 0.90 0.45"
        contype="0"
        conaffinity="0"/>

    <!-- Left laboratory bench -->
    <geom
        name="left_bench"
        type="box"
        pos="2.7 2.7 0.35"
        size="0.65 0.30 0.35"
        rgba="0.30 0.34 0.38 1"/>

    <!-- Right laboratory bench -->
    <geom
        name="right_bench"
        type="box"
        pos="2.7 -2.7 0.35"
        size="0.65 0.30 0.35"
        rgba="0.30 0.34 0.38 1"/>

    <!-- Decorative floor markers -->
    <geom
        name="marker_left"
        type="box"
        pos="1.5 1.5 0.004"
        size="0.30 0.03 0.004"
        rgba="0.95 0.75 0.10 1"
        contype="0"
        conaffinity="0"/>

    <geom
        name="marker_right"
        type="box"
        pos="1.5 -1.5 0.004"
        size="0.30 0.03 0.004"
        rgba="0.95 0.75 0.10 1"
        contype="0"
        conaffinity="0"/>

<!-- ========================= -->
<!-- OBJECT DISPLAY TABLES     -->
<!-- ========================= -->

<!-- Table under red mug -->
<body name="red_mug_table" pos="2.0 1.0 0">
    <geom name="red_table_top"
          type="box"
          pos="0 0 0.20"
          size="0.25 0.25 0.025"
          rgba="0.45 0.30 0.18 1"/>

    <geom name="red_table_leg"
          type="box"
          pos="0 0 0.09"
          size="0.07 0.07 0.09"
          rgba="0.35 0.23 0.12 1"/>
</body>

<!-- Table under white mug -->
<body name="white_mug_table" pos="2.0 0.0 0">
    <geom name="white_table_top"
          type="box"
          pos="0 0 0.20"
          size="0.25 0.25 0.025"
          rgba="0.45 0.30 0.18 1"/>

    <geom name="white_table_leg"
          type="box"
          pos="0 0 0.09"
          size="0.07 0.07 0.09"
          rgba="0.35 0.23 0.12 1"/>
</body>

<!-- Table under green bowl -->
<body name="bowl_table" pos="2.0 -1.0 0">
    <geom name="bowl_table_top"
          type="box"
          pos="0 0 0.20"
          size="0.25 0.25 0.025"
          rgba="0.45 0.30 0.18 1"/>

    <geom name="bowl_table_leg"
          type="box"
          pos="0 0 0.09"
          size="0.07 0.07 0.09"
          rgba="0.35 0.23 0.12 1"/>
</body>

   
 
  <!-- MuJoCo mug target -->
<body name="mug_target"
      pos="2.0 0 0.225"
      quat="0.7071 0 0 0.7071">


    <geom name="mug_visual"
          type="mesh"
          mesh="mug_mesh"
          material="mug_material"
          euler="1.5708 0 0"
          contype="0"
          conaffinity="0"/>

</body>
<body name="red_mug_target"
      pos="2.0 1.0 0.225"
      quat="0.7071 0 0 0.7071">

    <geom name="red_mug_visual"
          type="mesh"
          mesh="mug_mesh"
          material="red_mug_material"
          euler="1.5708 0 0"
          contype="0"
          conaffinity="0"/>
</body>   

<body name="bowl_target" pos="2.0 -1.0 0.225">
    <geom name="bowl_visual"
          type="mesh"
          mesh="bowl_mesh"
          rgba="0.15 0.75 0.25 1"
          contype="0"
          conaffinity="0"/>

<geom name="bowl_base"
      type="cylinder"
      pos="0 0 0.003"
      size="0.060 0.003"
      rgba="0.15 0.75 0.25 1"
      contype="0"
      conaffinity="0"/>


</body>


  </worldbody>

</mujoco>
